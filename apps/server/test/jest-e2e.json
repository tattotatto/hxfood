{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@hxfood/shared-types$": "<rootDir>/../../packages/shared-types/src",
    "^@hxfood/shared-utils$": "<rootDir>/../../packages/shared-utils/src"
  }
}
